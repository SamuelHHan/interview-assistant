# ============================================
# AI面试助手 - 环境变量配置
# 所有模块通过Docker Compose部署
# ============================================

# --------------------------------------------
# 数据库配置
# --------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_NAME=interview_assistant
DB_USER=root
DB_PASSWORD=root123456

# --------------------------------------------
# 服务配置
# --------------------------------------------
PORT=3001
NODE_ENV=development

# ⚠️ 重要：候选人通过邮件里的链接访问系统，必须设置为服务器公网地址
# 本地开发: http://localhost
# 服务器部署: http://你的服务器IP  例如 http://47.98.123.45
FRONTEND_URL=http://你的服务器IP

# --------------------------------------------
# 邮件配置（用于发送面试邀请）
# --------------------------------------------
EMAIL_HOST=smtp.163.com
EMAIL_PORT=465
EMAIL_USER=your_email@163.com
EMAIL_PASSWORD=your_email_password

# --------------------------------------------
# Qwen AI API配置（通义千问）
# --------------------------------------------
QWEN_API_KEY=your_qwen_api_key
# 使用OpenAI兼容模式（代码会自动补全 /chat/completions 路径）
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --------------------------------------------
# LiveKit 自建服务器配置
# --------------------------------------------
LIVEKIT_API_KEY=livekit_api_key
LIVEKIT_API_SECRET=livekit_api_secret_change_me
# 后端调用LiveKit的内网地址（Docker网络内部，无需修改）
LIVEKIT_WS_URL=ws://livekit:7880
LIVEKIT_HTTP_URL=http://livekit:7880

# ⚠️ 重要：LiveKit向浏览器广播的WebRTC节点地址
# 必须设置为候选人浏览器能访问到的地址（服务器公网IP）
# 本地开发: 127.0.0.1
# 服务器部署: 你的服务器IP  例如 47.98.123.45
LIVEKIT_NODE_IP=你的服务器IP

# 前端连接LiveKit的WebSocket地址（本地开发默认即可，远程部署时前端会自动使用当前访问host）
LIVEKIT_PUBLIC_WS_URL=ws://localhost:7880